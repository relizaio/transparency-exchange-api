{
  "name": "tea-ecmarkup-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "generate-spec": "node build.js",
    "build-only": "ecmarkup --verbose spec.html out/index.html --max-clause-depth 6",
    "build-multipage": "ecmarkup --verbose spec.html --multipage out --max-clause-depth 6",
    "build": "npm run generate-spec && npm run build-only",
    "clean": "rm -rf out spec.html"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.0",
    "ecmarkup": "^21.5.0",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0"
  }
}
